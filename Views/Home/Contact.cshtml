@{
    ViewData["Title"] = "AutoGems.ai - Contact Us";
}

@if (TempData["ContactSuccess"] != null)
{
    <div class="fixed top-20 left-1/2 z-50 -translate-x-1/2 rounded-xl bg-green-100 px-8 py-4 text-green-800 shadow-lg">
        ✅ Message sent! We'll get back to you soon.
    </div>
}

<!-- Hero Banner — pt-16 clears the fixed navbar -->
<div class="car-Background relative flex w-full items-center justify-center overflow-hidden pt-25 pb-32">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>
    <div class="z-10 px-4 text-center">
        <h1 class="text-5xl font-extrabold text-white drop-shadow-lg">Contact Us</h1>
        <p class="mt-4 text-lg text-gray-200">We'd love to hear from you</p>
    </div>
    <div class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-b from-transparent to-[#EAE0D5]"></div>
</div>

<section class="bg-[#EAE0D5] px-8 py-20">
    <div class="mx-auto grid max-w-5xl gap-16 lg:grid-cols-2">

        <!-- Left: Info -->
        <div>
            <h2 class="mb-6 text-3xl font-extrabold text-[#0A0908]">Say Hello</h2>
            <p class="mb-10 text-lg leading-relaxed text-[#5E503F]">
                Have a question, suggestion, or just want to say hi? Fill out the form and
                we'll get back to you as soon as we can.
            </p>

            <div class="space-y-6">
                <div class="flex items-start gap-4">
                    <span class="text-2xl">📧</span>
                    <div>
                        <p class="font-semibold text-[#22333B]">Email</p>
                        <p class="text-[#5E503F]">hello@autogems.ai</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="text-2xl">🐦</span>
                    <div>
                        <p class="font-semibold text-[#22333B]">Twitter / X</p>
                        <p class="text-[#5E503F]">@@AutoGemsAI</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="text-2xl">📍</span>
                    <div>
                        <p class="font-semibold text-[#22333B]">Location</p>
                        <p class="text-[#5E503F]">United States</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Form -->
        <div class="rounded-2xl bg-[#f5ede3] p-10 shadow-md border border-[#C6AC8F]">
            <form method="post" asp-controller="Home" asp-action="Contact" class="space-y-6">
                @Html.AntiForgeryToken()

                <div>
                    <label class="mb-1 block text-sm font-semibold text-[#22333B]">Name</label>
                    <input type="text" name="name" placeholder="Your name"
                           class="w-full rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-4 py-3 text-sm text-[#22333B]
                                  focus:border-[#5E503F] focus:ring-2 focus:ring-[#5E503F]/30 focus:outline-none" />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-[#22333B]">Email</label>
                    <input type="email" name="email" placeholder="you@example.com"
                           class="w-full rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-4 py-3 text-sm text-[#22333B]
                                  focus:border-[#5E503F] focus:ring-2 focus:ring-[#5E503F]/30 focus:outline-none" />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-[#22333B]">Subject</label>
                    <input type="text" name="subject" placeholder="What's this about?"
                           class="w-full rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-4 py-3 text-sm text-[#22333B]
                                  focus:border-[#5E503F] focus:ring-2 focus:ring-[#5E503F]/30 focus:outline-none" />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-[#22333B]">Message</label>
                    <textarea name="message" rows="5" placeholder="Tell us what's on your mind..."
                              class="w-full rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-4 py-3 text-sm text-[#22333B]
                                     focus:border-[#5E503F] focus:ring-2 focus:ring-[#5E503F]/30 focus:outline-none"></textarea>
                </div>

                <button type="submit"
                        class="w-full rounded-lg bg-[var(--tan)] py-3 font-semibold text-[var(--jet)]
                               shadow-md transition hover:bg-[var(--brown)] hover:text-[var(--bone)]">
                    Send Message
                </button>
            </form>
        </div>

    </div>
</section>
