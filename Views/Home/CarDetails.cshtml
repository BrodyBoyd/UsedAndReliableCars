@model List<UsedCar>

@{
    var grouped = Model
        .GroupBy(c => c.PriceCategory)
        .OrderBy(g => g.Key);
}

<section class="w-full bg-slate-900 py-20 pt-36 px-6">

    <div class="max-w-6xl mx-auto mb-12 text-center">
        <h1 class="text-5xl font-extrabold text-white drop-shadow-xl">
            Explore AutoGems by Price
        </h1>
        <p class="text-slate-300 text-lg mt-4 max-w-2xl mx-auto">
            Every price range has its champions — hand‑picked by our Agentic AI for reliability, value, and long‑term satisfaction.
        </p>
    </div>

    @foreach (var group in grouped)
    {
        var id = $"group_{group.Key}";

        <div class="mb-10 border border-slate-700 rounded-xl overflow-hidden bg-slate-900/70 shadow-xl">

            <!-- Accordion Header -->
            <button type="button"
                    class="w-full flex justify-between items-center px-6 py-4 bg-slate-800 hover:bg-slate-700 transition"
                    onclick="toggleAccordion('@id')">

                <span class="text-2xl font-bold text-[var(--electric)]">
                    Under $@group.Key.ToString("N0")
                </span>

                <svg class="w-6 h-6 text-slate-300 transition-transform"
                     fill="none" stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            <!-- Accordion Content -->
            <div id="@id" class="max-h-0 overflow-hidden transition-all duration-300">

                <div class="p-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

                    @foreach (var car in group)
                    {
                        <div class="relative group breathing-card overflow-hidden rounded-3xl p-[2px]
                    bg-slate-800/40 backdrop-blur-xl shadow-[0_0_50px_-15px_var(--electric)]"
                             data-breath-card>

                            <!-- DATA RAIN BACKGROUND -->
                            <canvas class="absolute inset-0 opacity-30 pointer-events-none" data-rain></canvas>

                            <!-- GLASS LAYERS -->
                            <div class="absolute inset-0 pointer-events-none">
                                <div class="absolute inset-0 bg-white/5 backdrop-blur-3xl rounded-3xl
                            animate-glassDrift"></div>

                                <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent
                            rounded-3xl mix-blend-overlay animate-glassDriftReverse"></div>
                            </div>

                            <!-- INNER CONTENT -->
                            <div class="relative bg-slate-900/80 backdrop-blur-2xl rounded-3xl p-8 z-10
                        transition-transform duration-700 group-hover:scale-[1.03] group-hover:rotate-[0.4deg]">

                                <!-- TITLE -->
                                <h2 class="text-3xl font-extrabold text-white tracking-wide drop-shadow-xl
                           bg-clip-text text-transparent bg-gradient-to-r
                           from-white via-slate-300 to-white">
                                    @car.Year @car.Make @car.Model
                                </h2>

                                <p class="text-slate-400 text-sm mt-1 italic">
                                    @car.Type • Under $@car.PriceCategory.ToString("N0")
                                </p>

                                <!-- DIVIDER -->
                                <div class="h-px w-full bg-gradient-to-r from-transparent via-white/20 to-transparent my-6"></div>

                                <!-- DETAILS -->
                                <div class="space-y-2 text-slate-300 text-sm">
                                    <p><span class="font-semibold text-white/90">Make:</span> @car.Make</p>
                                    <p><span class="font-semibold text-white/90">Model:</span> @car.Model</p>
                                    <p><span class="font-semibold text-white/90">Year:</span> @car.Year</p>
                                    <p><span class="font-semibold text-white/90">Category:</span> Under $@car.PriceCategory.ToString("N0")</p>
                                </div>

                                <!-- CTA -->
                                

                                    <!-- BREATHING GLOW -->
                                    <span class="absolute inset-0 bg-[var(--electric)]/30 blur-3xl opacity-0
                                 group-hover:opacity-40 animate-breathPulse"></span>

                                
                            </div>
                        </div>
                    }

                </div>

            </div>
        </div>
    }
</section>

<script>
    function toggleAccordion(id) {
        const section = document.getElementById(id);

        if (!section) return;

        // If closed → open it
        if (section.style.maxHeight === "" || section.style.maxHeight === "0px") {
            section.style.maxHeight = section.scrollHeight + "px";
        }
        // If open → close it
        else {
            section.style.maxHeight = "0px";
        }
    }
</script>

<script>
    document.querySelectorAll("[data-rain]").forEach(canvas => {
        const ctx = canvas.getContext("2d");
        const w = canvas.width = canvas.offsetWidth;
        const h = canvas.height = canvas.offsetHeight;

        const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const drops = Array(Math.floor(w / 14)).fill(1);

        function draw() {
            ctx.fillStyle = "rgba(0,0,0,0.08)";
            ctx.fillRect(0, 0, w, h);

            ctx.fillStyle = "rgba(255,255,255,0.25)";
            ctx.font = "14px monospace";

            drops.forEach((y, i) => {
                const text = chars[Math.floor(Math.random() * chars.length)];
                ctx.fillText(text, i * 14, y * 14);

                if (y * 14 > h && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            });

            requestAnimationFrame(draw);
        }

        draw();
    });
</script>