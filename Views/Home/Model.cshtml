@model UsedCar
@{
    ViewData["Title"] = $"AutoGems.ai - {Model.Make} {Model.Model}";
}

<div class="min-h-full bg-[#EAE0D5] pt-24 pb-20">
    <div class="container mx-auto px-4 xl:max-w-3xl">

        <!-- Breadcrumb -->
        <nav class="mb-6 text-sm text-[#5E503F]">
            <a asp-controller="Home" asp-action="Index" class="hover:underline">Home</a>
            <span class="mx-2">/</span>
            <a asp-controller="Home" asp-action="Car" class="hover:underline">Browse Cars</a>
            <span class="mx-2">/</span>
            <span class="font-semibold text-[#22333B]">@Model.Make @Model.Model</span>
        </nav>

        <!-- Detail Card -->
        <div class="overflow-hidden rounded-2xl bg-[#EAE0D5] border border-[#C6AC8F] shadow-xl">

            <!-- Card Header -->
            <div class="bg-[#22333B] px-10 py-8">
                <h1 class="text-4xl font-extrabold text-[#EAE0D5]">
                    @Model.Make @Model.Model
                </h1>
                <p class="mt-1 text-lg text-[#C6AC8F]">@Model.Year &mdash; @Model.Type</p>
            </div>

            <!-- Card Body -->
            <div class="px-10 py-8">
                <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">

                    <div class="rounded-lg border border-[#C6AC8F] bg-[#f5ede3] p-4 text-center">
                        <p class="text-xs font-semibold uppercase tracking-wide text-[#C6AC8F]">Make</p>
                        <p class="mt-1 text-xl font-bold text-[#22333B]">@Model.Make</p>
                    </div>

                    <div class="rounded-lg border border-[#C6AC8F] bg-[#f5ede3] p-4 text-center">
                        <p class="text-xs font-semibold uppercase tracking-wide text-[#C6AC8F]">Model</p>
                        <p class="mt-1 text-xl font-bold text-[#22333B]">@Model.Model</p>
                    </div>

                    <div class="rounded-lg border border-[#C6AC8F] bg-[#f5ede3] p-4 text-center">
                        <p class="text-xs font-semibold uppercase tracking-wide text-[#C6AC8F]">Year</p>
                        <p class="mt-1 text-xl font-bold text-[#22333B]">@Model.Year</p>
                    </div>

                    <div class="rounded-lg border border-[#C6AC8F] bg-[#f5ede3] p-4 text-center">
                        <p class="text-xs font-semibold uppercase tracking-wide text-[#C6AC8F]">Budget</p>
                        <p class="mt-1 text-xl font-bold text-[#22333B]">Under $@String.Format("{0:N0}", Model.PriceCategory)</p>
                    </div>

                </div>

                <!-- Action Buttons -->
                <div class="mt-10 flex flex-wrap gap-4">
                    <button type="button"
                            class="rounded-lg bg-[var(--tan)] px-8 py-3 font-semibold text-[var(--jet)]
                                   shadow-md transition hover:bg-[var(--brown)] hover:text-[var(--bone)]">
                        Search Nearby
                    </button>
                    <a asp-controller="Home" asp-action="Car"
                       class="rounded-lg border border-[#C6AC8F] px-8 py-3 font-semibold text-[#5E503F]
                              transition hover:bg-[#C6AC8F]/30">
                        ← Back to All Cars
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
