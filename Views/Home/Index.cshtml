@model UsedCar
@{
    ViewData["Title"] = "AutoGems.ai - Find the cheapest and most reliable used cars near you!";
}
<div class="">

    <!-- Hero -->
    <div class="car-Background bg-gray-50pt-32 relative flex w-full items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>

        <div class="z-10 container mx-auto grid items-center gap-12 px-4 py-16 md:px-10 md:py-32 lg:grid-cols-2 lg:px-32 xl:max-w-6xl">

            <!-- LEFT SIDE (Form) -->
            <div id="bottomSection" class="order-2 rounded-2xl bg-white px-10 py-14 shadow-xl lg:order-1">
                <h1 class="text-4xl font-extrabold text-gray-900">
                    Find Your Car!
                </h1>

                <p class="mt-6 leading-relaxed text-gray-600">
                    <span class="font-semibold text-gray-900">You want the best!</span>
                    We want that for you as well. No more guessing whether that car is right for you.
                    Let us help you find the perfect used and reliable car within your budget.
                    Listed below are the most reliable used cars according to Consumer Report and Dave Ramsey.
                </p>
                <div class="flex">
                    <a href="https://www.consumerreports.org/cars/best-used-cars-10-top-picks-a8027733372/#used-car-top-picks-under-10000" target="_blank">
                        <img src="~/images/ConsumerReportLogo.png" alt="Consumer Reports Logo" class="mt-4 h-12 cursor-pointer" />
                    </a>
                    <a href="https://www.ramseysolutions.com/insurance/new-car-vs-used-car" target="_blank">
                        <img src="~/images/RamseyLogo.jpg" alt="Dave Ramsey Logo" class="mt-4 h-12 cursor-pointer" />
                    </a>
                </div>

                <form class="mt-10 space-y-5">
                    @{
                        var grouped = Model.UsedCars
                            .GroupBy(c => c.PriceCategory)
                            .OrderBy(g => g.Key);
                    }

                    @foreach (var group in grouped)
                    {
                        var id = $"group_{group.Key}";
                        <div class="mb-6 overflow-hidden rounded-lg border">

                            <!-- Accordion Header -->
                            <button type="button"
                                    class="flex w-full items-center justify-between bg-gray-100 px-4 py-3 transition hover:bg-gray-200"
                                    onclick="toggleAccordion('@id')">
                                <span class="text-lg font-semibold text-gray-800">
                                    Under $@String.Format("{0:N0}", group.Key)
                                </span>
                                <svg id="@(id)_icon"
                                     class="h-5 w-5 text-gray-600 transition-transform duration-300"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <!-- Accordion Content -->
                            <div id="@id" class="max-h-0 overflow-hidden bg-white transition-all duration-300">
                                <div class="space-y-3 p-4">
                                    @foreach (var car in group)
                                    {
                                        <div class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50">
                                            <input type="checkbox"
                                                   value="@car.Model"
                                                   class="h-4 w-4 border-gray-300 focus:ring-2 focus:ring-blue-300" />
                                            <div class="flex flex-col">
                                                <a asp-controller="Home" asp-action="CarModel"
                                                   asp-route-make="@car.Make" asp-route-model="@car.Model"
                                                   class="text-sm font-semibold text-blue-600 hover:underline">
                                                    @car.Make @car.Model (@car.Year)
                                                </a>
                                                <span class="text-xs text-gray-400">@car.Type</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    }
                </form>
            </div>

            <!-- RIGHT SIDE (Heading + Buttons) -->
            <div class="order-1 text-center lg:order-2 lg:text-left">
                <h1 class="text-4xl leading-tight font-extrabold text-white drop-shadow-lg sm:text-5xl">
                    AutoGems.ai
                </h1>

                <p class="mt-8 mb-12 text-lg text-gray-100 drop-shadow-md">
                    Find used and reliable cars near you!
                </p>

                <div class="flex flex-wrap justify-center gap-4 lg:justify-start">
                    <button id="scrollBtn"
                            class="rounded bg-[var(--electric)] px-8 py-3 text-lg font-semibold text-[var(--dark)]
                       transition-transform hover:scale-105 hover:shadow-[0_10px_20px_-10px_black]">
                        Find My Next Car!
                    </button>

                    <a href="#aiSection"
                       class="rounded border border-white px-8 py-3 text-lg text-white
                      transition-colors hover:bg-white hover:text-black">
                        About our Service
                    </a>
                </div>
            </div>

        </div>

        <div class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-b from-transparent to-white"></div>

    </div>


    <!-- Feature Strip -->
    <section class="w-full bg-white px-8 py-16">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 text-center md:grid-cols-3">
            <div>
                <h3 class="mb-2 text-2xl font-bold">Fast</h3>
                <p class="text-gray-600">Find hundreds of used cars at the click of a button</p>
            </div>
            <div>
                <h3 class="mb-2 text-2xl font-bold">Accurate</h3>
                <p class="text-gray-600">Find exactly what you're searching for</p>
            </div>
            <div>
                <h3 class="mb-2 text-2xl font-bold">Only The Best</h3>
                <p class="text-gray-600">We do our research so that you will only find the best used cars</p>
            </div>
        </div>
    </section>

    <!-- AI Section -->
    <section id="aiSection" class="line-bg relative flex min-h-screen w-screen justify-center px-8 py-16">

        <!-- Top fade -->
        <div class="pointer-events-none absolute top-0 left-0 h-32 w-full bg-gradient-to-t from-transparent to-white"></div>

        <!-- Bottom fade -->
        <div class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-b from-transparent to-white"></div>

        <div class="max-w-8xl mx-auto gap-10 text-center transition">
            <div>
                <h3 class="mb-2 text-2xl font-bold text-white">AI Integration</h3>
                <p class="text-gray-200">Ask our ai for help finding the car that fits your exact needs (Coming Soon)</p>

                <div id="askAiButton"
                     class="outer-cont flex transform cursor-pointer items-center gap-2 duration-500">
                    <svg viewBox="0 0 24 24" height="24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <g fill="none">
                            <path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"></path>
                            <path d="M9.107 5.448c.598-1.75 3.016-1.803 3.725-.159l.06.16l.807 2.36a4 4 0 0 0 2.276 2.411l.217.081l2.36.806c1.75.598 1.803 3.016.16 3.725l-.16.06l-2.36.807a4 4 0 0 0-2.412 2.276l-.081.216l-.806 2.361c-.598 1.75-3.016 1.803-3.724.16l-.062-.16l-.806-2.36a4 4 0 0 0-2.276-2.412l-.216-.081l-2.36-.806c-1.751-.598-1.804-3.016-.16-3.724l.16-.062l2.36-.806A4 4 0 0 0 8.22 8.025l.081-.216zM11 6.094l-.806 2.36a6 6 0 0 1-3.49 3.649l-.25.091l-2.36.806l2.36.806a6 6 0 0 1 3.649 3.49l.091.25l.806 2.36l.806-2.36a6 6 0 0 1 3.49-3.649l.25-.09l2.36-.807l-2.36-.806a6 6 0 0 1-3.649-3.49l-.09-.25zM19 2a1 1 0 0 1 .898.56l.048.117l.35 1.026l1.027.35a1 1 0 0 1 .118 1.845l-.118.048l-1.026.35l-.35 1.027a1 1 0 0 1-1.845.117l-.048-.117l-.35-1.026l-1.027-.35a1 1 0 0 1-.118-1.845l.118-.048l1.026-.35l.35-1.027A1 1 0 0 1 19 2"
                                  fill="currentColor"></path>
                        </g>
                    </svg>
                    Ask Our AI for Help
                </div>
            </div>
        </div>

        <div id="aiChatbox"
             class="mx-auto mt-10 hidden w-[60%] translate-y-4 opacity-0 transition-all duration-500">
            <div class="card">
                <div class="chat-header">Chat</div>
                <div class="chat-window">
                    <ul class="message-list"></ul>
                </div>
                <div class="chat-input">
                    <input type="text" class="message-input" placeholder="Type your message here">
                    <button class="send-button">Send</button>
                </div>
            </div>
        </div>

    </section>

</div>

@* Chatbox open script *@
<script>
    const btn = document.getElementById("askAiButton");
    const box = document.getElementById("aiChatbox");

    btn.addEventListener("click", () => {
        box.classList.remove("hidden");
        requestAnimationFrame(() => {
            box.classList.remove("opacity-0", "translate-y-4");
            box.classList.add("opacity-100", "translate-y-0");
        });
    });

    document.getElementById("scrollBtn").addEventListener("click", () => {
        document.getElementById("bottomSection").scrollIntoView({ behavior: "smooth" });
    });

    function toggleAccordion(id) {
        const content = document.getElementById(id);
        const icon = document.getElementById(id + "_icon");

        if (content.style.maxHeight) {
            content.style.maxHeight = null;
            icon.style.transform = "rotate(0deg)";
        } else {
            content.style.maxHeight = content.scrollHeight + "px";
            icon.style.transform = "rotate(180deg)";
        }
    }
</script>
