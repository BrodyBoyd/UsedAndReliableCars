@model UsedCar
@{
    ViewData["Title"] = "AutoGems - Find the cheapest and most reliable used cars near you!";
}
<div class="">

    <!-- Hero -->
    <div class="relative w-full  flex items-center justify-center overflow-hidden bg-gray-50 pt-32 bg-gray-200 car-Background ">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>


        <div class="container mx-auto grid lg:grid-cols-2 gap-12 items-center px-4 py-16 md:py-32 md:px-10 lg:px-32 xl:max-w-6xl z-10">

            
            <!-- LEFT SIDE (Form) -->
            <div id="bottomSection" class="order-2 lg:order-1 bg-white shadow-xl rounded-2xl px-10 py-14">
                <h1 class="text-4xl font-extrabold text-gray-900">
                    Find Your Car!
                </h1>

                <p class="mt-6 text-gray-600 leading-relaxed">
                    <span class="font-semibold text-gray-900">You want the best!</span>
                    We want that for you as well. We use Agentic AI to scan the market for the only cars worth buying: the ones that are used, reliable, determined by our Agent to be an AutoGem.

                    Listed below are the most reliable used cars according to Consumer Report and Dave Ramsey.
                </p>
                <div class="flex">
                    <a href="https://www.consumerreports.org/cars/best-used-cars-10-top-picks-a8027733372/#used-car-top-picks-under-10000" target="_blank">
                        <img src="~/images/ConsumerReportLogo.png"  alt="Consumer Reports Logo" class="h-12 mt-4 cursor-pointer" />
                    </a>
                    <a href="https://www.ramseysolutions.com/insurance/new-car-vs-used-car" target="_blank">
                        <img src="~/images/RamseyLogo.jpg" alt="Dave Ramsey Logo" class="h-12 mt-4 cursor-pointer" />
                    </a>
                </div>

                <form class="mt-10 space-y-5">
                    @{
                        var grouped = Model.UsedCars
                        .GroupBy(c => c.PriceCategory)
                        .OrderBy(g => g.Key);
                    }

                    @foreach (var group in grouped)
                    {
                        var id = $"group_{group.Key}";
                        <div class="mb-6 border rounded-lg overflow-hidden">

                            <!-- Accordion Header -->
                            <button type="button"
                                    class="w-full flex justify-between items-center px-4 py-3 bg-gray-100 hover:bg-gray-200 transition"
                                    onclick="toggleAccordion('@id')">

                                <span class="text-lg font-semibold text-gray-800">
                                    Under $@group.Key.ToString("N0")
                                </span>

                                <svg class="w-5 h-5 text-gray-600 transition-transform"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <!-- Accordion Content -->
                            <div id="@id" class="max-h-0 overflow-hidden transition-all duration-300 bg-white">
                                <div class="p-4 space-y-3">
                                    @foreach (var car in group)
                                    {
                                        <label class="flex items-center gap-3 p-3 rounded-lg border cursor-pointer hover:bg-gray-50">
                                            <input type="radio"
                                                   name="carSelection"
                                                   id="@car.CarId"
                                                   value="@car.Model"
                                                   class="h-4 w-4 border-gray-300 focus:ring-2 focus:ring-blue-300" />

                                            <span class="text-sm font-medium text-gray-900">
                                                @car.Make @car.Model (@car.Year)
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>

                        </div>
                    }
                </form>
            </div>
            <!-- RIGHT SIDE (Heading + Buttons) -->
            <div class="order-1 lg:order-2 text-center lg:text-left">
                <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight text-white drop-shadow-lg">
                    AutoGems
                </h1>

                <p class="mt-8 mb-12 text-lg text-gray-100 drop-shadow-md">
                    Stop Searching. Start Finding Used & Reliable Auto Gems
                </p>

                <div class="flex flex-wrap lg:justify-start justify-center gap-4">
                    <button id="searchBtn"
                        href="#resultsDiv"
                            class="px-8 py-3 text-lg font-semibold rounded bg-[var(--electric)] text-slate-900
                       hover:shadow-[0_10px_20px_-10px_black] hover:scale-105 transition-transform">
                        Find My Next Car!
                    </button>

                    <a href="#"
                       class="px-8 py-3 text-lg border rounded text-white border-white
                      hover:bg-white hover:text-black transition-colors">
                        About our Service
                    </a>
                </div>
            </div>


        </div>


        <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-b from-transparent to-slate-900 pointer-events-none"></div>

    </div>


    <!-- Feature Strip -->
    <section class="w-full bg-slate-900 py-16 px-8">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 text-center">

            <div>
                <h3 class="text-2xl font-bold mb-2 text-[var(--electric)]">
                    Reliability First
                </h3>
                <p class="text-slate-300">
                    We start with the latest Consumer Reports "Top Picks" and reliability ratings.
                    If it isn't built to last, it isn't on our site.
                </p>
            </div>

            <div>
                <h3 class="text-2xl font-bold mb-2 text-[var(--electric)]">
                    Market Intelligence
                </h3>
                <p class="text-slate-300">
                    We pull live For Sale By Owner (FSBO) listings from across the internet to show
                    every available option in your area.
                </p>
            </div>

            <div>
                <h3 class="text-2xl font-bold mb-2 text-[var(--electric)]">
                    Agentic Analysis
                </h3>
                <p class="text-slate-300">
                    Our AI agents calculate the "Value Score"—a proprietary blend of price, mileage,
                    and historical depreciation—to identify the true standouts.
                </p>
            </div>

        </div>
    </section>

    <div class="bg-gradient-to-b from-slate-900 to-[var(--electric)]">
        <section class="max-w-6xl mx-auto px-4 py-20 ">

            <!-- Header -->
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-3xl font-extrabold text-white">
                    Search Results
                </h2>
                <p id="DisplayResultsTotal" class="text-slate-400 text-sm hidden">
                    Showing <span id="ResultCount" class="font-semibold"></span> cars based on your filters
                </p>
            </div>

            <!-- Sorting -->
            @* <div class="flex items-center gap-4 mb-10">
                <label class="text-sm font-medium text-slate-300">Sort by:</label>

                <select onchange="ChangeSort()" id="sortBy"
                        class="border border-slate-700 rounded-xl px-4 py-2 text-sm bg-slate-800 text-slate-200 shadow-sm
                           focus:ring-2 focus:ring-[var(--electric)] focus:border-[var(--electric)]">
                    <option value="price">Price: Low to High</option>
                    <option value="miles">Miles: Low to High</option>
                </select>
            </div> *@

            <p id="loading" class="hidden text-slate-300">Loading...</p>

            <!-- Results Grid -->
            <div id="resultsDiv" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-5">
                <!-- Car Cards will be injected here -->
            </div>

            <!-- Pagination -->
            <div id="PageButtons" class="hidden mt-6">
                <p id="CurrentPage" class="text-slate-300 mb-3"></p>

                <button class="text-xl rounded-xl bg-slate-800 px-4 py-3 text-slate-200 border border-slate-700
                           hover:border-[var(--electric)] hover:shadow-[0_10px_20px_-10px_black] hover:scale-105 mr-3 transition"
                onclick="BackPage()">
                    Back
                </button>

                <button class="text-xl rounded-xl bg-slate-800 px-4 py-3 text-slate-200 border border-slate-700
                           hover:border-[var(--electric)] hover:shadow-[0_10px_20px_-10px_black] hover:scale-105 transition"
                onclick="ForwardPage()">
                    Forward
                </button>
            </div>

        </section>
    </div>



    @* ai section *@
    <section class="relative flex w-screen line-bg py-16 px-8 justify-center min-h-screen">

        <!-- Top fade (into previous section) -->
        <div class="absolute top-0 left-0 w-full h-32
                bg-gradient-to-t from-transparent to-[var(--electric)]
                pointer-events-none"></div>

        <!-- Bottom fade (into next section) -->
        <div class="absolute bottom-0 left-0 w-full h-32
                bg-gradient-to-b from-transparent to-slate-900
                pointer-events-none"></div> 

        <div class="max-w-8xl mx-auto gap-10 text-center transition">
            <div>
                <h3 class="text-2xl font-bold mb-2 text-white">AI Integration</h3>
                <p class="text-gray-200">Ask our ai for help finding the car that fits your exact needs (Coming Soon)</p>

                <div id="askAiButton"
                     class="outer-cont flex items-center gap-2 cursor-pointer duration-500 transform">

                    <!-- SVG unchanged -->
                    <svg viewBox="0 0 24 24" height="24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <g fill="none">
                            <path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"></path>
                            <path d="M9.107 5.448c.598-1.75 3.016-1.803 3.725-.159l.06.16l.807 2.36a4 4 0 0 0 2.276 2.411l.217.081l2.36.806c1.75.598 1.803 3.016.16 3.725l-.16.06l-2.36.807a4 4 0 0 0-2.412 2.276l-.081.216l-.806 2.361c-.598 1.75-3.016 1.803-3.724.16l-.062-.16l-.806-2.36a4 4 0 0 0-2.276-2.412l-.216-.081l-2.36-.806c-1.751-.598-1.804-3.016-.16-3.724l.16-.062l2.36-.806A4 4 0 0 0 8.22 8.025l.081-.216zM11 6.094l-.806 2.36a6 6 0 0 1-3.49 3.649l-.25.091l-2.36.806l2.36.806a6 6 0 0 1 3.649 3.49l.091.25l.806 2.36l.806-2.36a6 6 0 0 1 3.49-3.649l.25-.09l2.36-.807l-2.36-.806a6 6 0 0 1-3.649-3.49l-.09-.25zM19 2a1 1 0 0 1 .898.56l.048.117l.35 1.026l1.027.35a1 1 0 0 1 .118 1.845l-.118.048l-1.026.35l-.35 1.027a1 1 0 0 1-1.845.117l-.048-.117l-.35-1.026l-1.027-.35a1 1 0 0 1-.118-1.845l.118-.048l1.026-.35l.35-1.027A1 1 0 0 1 19 2"
                                  fill="currentColor"></path>
                        </g>
                    </svg>
                    Ask Our AI for Help
                </div>
            </div>
        </div>

        <div id="aiChatbox"
             class="hidden opacity-0 translate-y-4 transition-all duration-500 w-[60%] mx-auto mt-10">
            <div class="card">
                <div class="chat-header">Chat</div>
                <div class="chat-window">
                    <ul class="message-list"></ul>
                </div>
                <div class="chat-input">
                    <input type="text" class="message-input" placeholder="Type your message here">
                    <button class="send-button">Send</button>
                </div>
            </div>
        </div>



    </section>
@section Scripts 
{

    <script>
        const btn = document.getElementById("askAiButton");
        const box = document.getElementById("aiChatbox");

        btn.addEventListener("click", () => {

            // Reveal chatbox
            box.classList.remove("hidden");

            requestAnimationFrame(() => {
                box.classList.remove("opacity-0", "translate-y-4");
                box.classList.add("opacity-100", "translate-y-0");
            });
        });

        const scrollBtn = document.getElementById("scrollBtn");
        if (scrollBtn) {
            scrollBtn.addEventListener("click", () => {
                const bottom = document.getElementById("bottomSection");
                if (bottom) {
                    bottom.scrollIntoView({ behavior: "smooth" });
                }
            });
        }

        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById(id + "_icon");
            if (!content) return;

            if (content.style.maxHeight) {
                content.style.maxHeight = null;
                if (icon) icon.style.transform = "rotate(0deg)";
            } else {
                content.style.maxHeight = content.scrollHeight + "px";
                if (icon) icon.style.transform = "rotate(180deg)";
            }
        }
        </script>
        <script>

            let PageNum = 0;
            let ResultTotalAmount;

            const BackPage = () => {
                if(PageNum > 0) {
                    PageNum--;
                    document.getElementById("CurrentPage").innerHTML = `Page: ${PageNum + 1}`;
                    document.getElementById("searchBtn").click();
                }
            }

            const ForwardPage = () => {
                PageNum++;
                if (((PageNum * 6) - ResultTotalAmount) < 0){
                    document.getElementById("CurrentPage").innerHTML = `Page: ${PageNum + 1}`;
                    document.getElementById("searchBtn").click();
                } 
                else {
                    PageNum--;
                }
            }

            const ChangeSort = () => {
                console.log(document.getElementById('sortBy').value);

                document.getElementById("searchBtn").click();
            }

            document.getElementById("searchBtn").addEventListener("click", async () => {
                const loading = document.getElementById("loading");
                const resultsDiv = document.getElementById("resultsDiv");
                const sortBy = document.getElementById("sortBy");

                if (loading) loading.classList.remove("hidden");
                if (resultsDiv) resultsDiv.innerHTML = '';

                const params = new URLSearchParams();
                // add params here
                const toyotaCorolla = document.getElementById("ToyotaCorolla").checked;
                if (toyotaCorolla) {
                  params.append("make", "toyota");
                  params.append("model", "corolla");
                  params.append("year", 2019);
                  params.append("priceMax", 15000);
                }

                const mazda6 = document.getElementById("Mazda6").checked;
                if (mazda6) {
                  params.append("make", "mazda");
                  params.append("model", "mazda6");
                  params.append("year", 2016);
                  params.append("priceMax", 10000);

                }

                const chevroletEquinox = document.getElementById("ChevroletEquinox").checked;
                if (chevroletEquinox) {
                  params.append("make", "chevrolet");
                  params.append("model", "equinox");
                  params.append("year", 2019);
                  params.append("priceMax", 15000);
                }

                const toyotaCorollaHybrid = document.getElementById("ToyotaCorollaHybrid").checked;
                if (toyotaCorollaHybrid) {
                  params.append("make", "toyota");
                  params.append("model", "corolla");
                  params.append("year", 2021);
                  params.append("priceMax", 20000);
                  params.append("type", "hybrid");

                }

                const subaruCrosstrek = document.getElementById("SubaruCrosstrek").checked;
                if (subaruCrosstrek) {
                  params.append("make", "subaru");
                  params.append("model", "crosstrek");
                  params.append("year", 2020);
                  params.append("priceMax", 20000);

                }

                const toyotaRav4Hybrid = document.getElementById("ToyotaRAV4Hybrid").checked;
                if (toyotaRav4Hybrid) {
                  params.append("make", "toyota");
                  params.append("model", "rav4");
                  params.append("year", 2018);
                  params.append("priceMax", 20000);
                  params.append("type", "hybrid");
                }

                const toyotaHighlander = document.getElementById("ToyotaHighlander").checked;
                if (toyotaHighlander) {
                  params.append("make", "toyota");
                  params.append("model", "highlander");
                  params.append("year", 2018);
                  params.append("priceMax", 20000);
                }

                const lexusNX = document.getElementById("LexusNX").checked;
                if (lexusNX) {
                  params.append("make", "lexus");
                  params.append("model", "nx");
                  params.append("year", 2018);
                  params.append("priceMax", 20000);
                }

                const mazdaMX5Miata = document.getElementById("MazdaMX5Miata").checked;
                if (mazdaMX5Miata) {
                  params.append("make", "mazda");
                  params.append("model", "mx-5");
                  params.append("year", 2021);
                  params.append("priceMax", 20000);

                }

                const hondaRidgeline = document.getElementById("HondaRidgeline").checked;
                if (hondaRidgeline) {
                  params.append("make", "honda");
                  params.append("model", "ridgeline");
                  params.append("year", 2020);
                  params.append("priceMax", 25000);
                }
                if (sortBy) {
                    params.append("sortBy", sortBy)
                }
                

                try {
                    params.append("PageNum", PageNum);

                    const response = await fetch(`/api/cars/search?${params.toString()}`);
                    if (!response.ok) throw new Error(`Server responded ${response.status}`);
                    const data = await response.json();
                    
                    const ResultCount = document.getElementById("ResultCount");
                    ResultCount.innerHTML = `${data.num_found}`;
                    

                    ResultTotalAmount = data.num_found;


                    const DisplayResultsTotal = document.getElementById("DisplayResultsTotal");
                    if (DisplayResultsTotal) DisplayResultsTotal.classList.remove("hidden");

                    
                    const PageButtons = document.getElementById("PageButtons");
                    if (PageButtons) PageButtons.classList.remove("hidden");

                   
                    if (data.listings && data.listings.length > 0) {
                    resultsDiv.innerHTML = data.listings.map(car => `
                                    <div class="bg-slate-900/80 border border-slate-700 rounded-2xl p-6 shadow-lg
                        hover:border-[var(--electric)] hover:shadow-[0_0_25px_-5px_var(--electric)]
                        hover:-translate-y-1 transition-all">

                <!-- Header -->
                <div class="flex justify-between items-start mb-3">
                    <h3 class="text-xl font-bold text-white">
                        ${car.heading || `${car.year} ${car.make} ${car.model}`}
                    </h3>
                </div>

                <!-- Price -->
                <p class="text-lg font-semibold text-violet-700">
                    $${(car.price != null) ? Number(car.price).toLocaleString() : 'Price Not Available'}
                </p>

                <!-- Divider -->
                <div class="h-px w-full bg-slate-700 my-4"></div>

                <!-- Details -->
                <div class="space-y-2 text-sm text-slate-300">
                    <p><span class="font-semibold text-white">Mileage:</span> ${(car.miles != null) ? Number(car.miles).toLocaleString() : 'N/A'}</p>

                    <p><span class="font-semibold text-white">Location:</span>
                        ${car.dealer?.city || ''}${car.dealer?.city ? ',' : ''} ${car.dealer?.state || ''}
                    </p>

                    <p><span class="font-semibold text-white">Color:</span>
                        ${car.exterior_color || car.paint_color || car.color || 'N/A'}
                    </p>
                </div>

                <!-- Button -->
                <a href="${car.vdp_url}" target="_blank" rel="noopener noreferrer"
                   class="mt-6 block w-full text-center px-4 py-3 rounded-xl font-semibold
                          bg-violet-700 text-slate-900
                          hover:bg-violet-600
                          hover:shadow-[0_0_20px_var(--electric)]
                          transition">
                    Select This Car
                </a>
            </div>
                    `).join('');
                } else {
                    resultsDiv.innerHTML = '<p class="text-gray-600">No results found</p>';
                }
                    
                } catch (error) {
                    if (resultsDiv) resultsDiv.innerHTML = `<p class="text-red-500">${error.message} </p>`;
                } finally {
                    if (loading) loading.classList.add("hidden");
                }
            });
        </script>
}