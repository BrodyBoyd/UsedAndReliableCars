@{
    ViewData["Title"] = "AutoGems.ai - About Us";
}

<!-- Hero Banner — pt-16 clears the fixed navbar -->
<div class="car-Background relative flex w-full items-center justify-center overflow-hidden pt-25 pb-32">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>
    <div class="z-10 px-4 text-center">
        <h1 class="text-5xl font-extrabold text-white drop-shadow-lg">About AutoGems.ai</h1>
        <p class="mt-4 text-lg text-gray-200">Helping everyday people find reliable used cars since 2026</p>
    </div>
    <div class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-b from-transparent to-[#EAE0D5]"></div>
</div>

<!-- Mission Section -->
<section class="bg-[#EAE0D5] px-8 py-20">
    <div class="mx-auto max-w-4xl text-center">
        <h2 class="mb-6 text-3xl font-extrabold text-[#0A0908]">Our Mission</h2>
        <p class="text-lg leading-relaxed text-[#5E503F]">
            In our fourth semester, we set out to build a platform that helps people find reliable used cars.
            Working in both groups and individually, we collaborated through GitHub, built the backend with
            ASP.NET Core MVC, and crafted the frontend using Tailwind CSS and vanilla JavaScript.
            <br><br>
            AutoGems.Ai analyzes real-time car data using our own AI agent, combining MarketCheck listings
            with Consumer Reports insights to deliver accurate, trustworthy recommendations.

        </p>
    </div>
</section>

<!-- Values Strip -->
<section class="bg-[#C6AC8F]/20 px-8 py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 md:grid-cols-3">

        <div class="rounded-2xl bg-[#EAE0D5] p-10 text-center shadow-md border border-[#C6AC8F]">
            <div class="mb-4 text-4xl">🔍</div>
            <h3 class="mb-2 text-xl font-bold text-[#22333B]">Research-Backed</h3>
            <p class="text-[#5E503F]">Every car on our list is vetted by industry-leading consumer research so you only see the best.</p>
        </div>

        <div class="rounded-2xl bg-[#EAE0D5] p-10 text-center shadow-md border border-[#C6AC8F]">
            <div class="mb-4 text-4xl">💰</div>
            <h3 class="mb-2 text-xl font-bold text-[#22333B]">Budget-Friendly</h3>
            <p class="text-[#5E503F]">We organize picks by price category so you can find a great car that fits your actual budget.</p>
        </div>

        <div class="rounded-2xl bg-[#EAE0D5] p-10 text-center shadow-md border border-[#C6AC8F]">
            <div class="mb-4 text-4xl">🤖</div>
            <h3 class="mb-2 text-xl font-bold text-[#22333B]">AI-Powered (Soon)</h3>
            <p class="text-[#5E503F]">Our upcoming AI assistant will give personalized recommendations based on your unique needs.</p>
        </div>

    </div>
</section>

<!-- Story Section -->
<section class="bg-[#EAE0D5] px-8 py-20">
    <div class="mx-auto max-w-3xl text-center">
        <h2 class="mb-6 text-3xl font-extrabold text-[#0A0908]">Our Story</h2>
        <p class="mb-6 text-lg leading-relaxed text-[#5E503F]">
            AutoGems.ai was born out of frustration. Like most people, we found the used car market overwhelming —
            full of overpriced lemons, pushy dealerships, and conflicting advice. We decided to build something better:
            a simple, honest tool that does the research for you.
        </p>
        <p class="text-lg leading-relaxed text-[#5E503F]">
            We're a small team of car enthusiasts and developers who are passionate about helping people make smart
            financial decisions. We hope AutoGems saves you time, money, and a whole lot of stress.
        </p>

        <a asp-controller="Home" asp-action="Contact"
           class="mt-10 inline-block rounded-lg bg-[var(--tan)] px-8 py-3 font-semibold text-[var(--jet)]
                  shadow-md transition hover:bg-[var(--brown)] hover:text-[var(--bone)]">
            Get in Touch
        </a>
    </div>
</section>
